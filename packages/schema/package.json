{
  "name": "@abc-cook/schema",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the abc_cook Pydantic JSON Schema. Do not hand-edit index.ts.",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "build": "json2ts --input schema.json --output index.ts --style.singleQuote --no-additionalProperties --unreachableDefinitions"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4"
  }
}
