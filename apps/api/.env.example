# Copy to .env (gitignored) and fill in. Keep this file current — it is committed.

# "local" | "staging" | "production"
APP_ENV=local

# Port uvicorn binds. The Makefile's `make api` target passes this.
PORT=8000

# Comma-separated origins allowed to call the API.
# The Vite dev server runs on 5173; add your machine's LAN IP to test on a phone.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider credentials land here in M2, alongside abc_cook/extract/.
# Nothing in abc_cook/ reads them yet.
