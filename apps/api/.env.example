# Copy to .env (gitignored) and fill in. Keep this file current — it is committed.

# "local" | "staging" | "production"
APP_ENV=local

# Port uvicorn binds. The Makefile's `make api` target passes this.
PORT=8000

# Comma-separated origins allowed to call the API.
# The Vite dev server runs on 5173. To open the app from a phone over the LAN, add the
# machine's LAN address as an origin too, e.g.
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider credentials, added for M2.9 (YouTube import), alongside abc_cook/extract/.
# "anthropic" | "openai" | "google" — see docs/M2.9-youtube-import-design.md §6.
# M2.11: repair (Sonnet) still reads this; kept as its own var rather than renamed,
# since AnthropicAdapter is unchanged and still reads LLM_API_KEY specifically.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# claude-sonnet-5 is used for the one-shot repair pass (repair.REPAIR_MODEL).
LLM_MODEL=claude-sonnet-5

# M2.11: extraction moved from Haiku to GPT-5-mini (normalize.DEFAULT_MODEL) --
# OpenAIAdapter reads this directly. Repair is unaffected; see LLM_API_KEY above.
OPENAI_API_KEY=

# A3 result cache: a repeat import of the same source returns the stored plan in <1 s.
# OFF unless this is set (tests, the A4 runner and prod stay cache-free by default).
# Uncomment to enable locally; the path is relative to where the API starts (apps/api).
# `POST /import?fresh=1` skips the lookup. Entries expire after 7 days (a placeholder, not
# a measured value) and are invalidated by any extraction/post-processing change.
# ABC_COOK_RESULT_CACHE_DIR=.cache/results
