  "steps": [
    {
      "text": "Chole ko dhoye: 1 cup Chole ko do baar paani se dhoye aur meetha soda (1/4 tsp) wale paani mein daal kar 6 घंटे के लिए soak karen.",
      "label": "Soak chole",
      "attention": "unattended",
      "attention_cue": "6 घंटे के लिए",
      "duration_typical_min": 360.0,
      "duration_min": 360.0,
      "duration_max": 420.0,
      "duration_stated": false,
      "depends_on_previous": false,
      "depends_on_steps": [],
