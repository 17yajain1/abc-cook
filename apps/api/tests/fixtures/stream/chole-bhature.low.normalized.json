      "freshness": "none",
      "freshness_cue": null,
      "max_lead_min": null,
      "doneness_cue": "jab cooker ka tala chhodne lage"
    },
    {
      "text": "Pressure release ke baad agar zarurat ho to aloo mash karein aur 10–15 मिनट tak gravy ko thoda pakne aur settle hone ke liye gas par chasein (transcript: \"10 से 15 मिनट में ठंडे होने के बाद सही हो जाएगा\").",
      "label": "Simmer and mash",
      "attention": "hands_on",
      "attention_cue": null,
