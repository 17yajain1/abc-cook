      ],
      "produces_component": "rested dough",
      "station": "none",
      "interruptible": true,
      "freshness": "none",
      "freshness_cue": null,
      "max_lead_min": null,
      "doneness_cue": null
    },
    {
      "text": "Chole ke liye pyaaz aur anardana ko bina pani ke mixie mein paste bana lein.",
      "label": "Make onion paste",
      "attention": "hands_on",
      "attention_cue": null,
      "duration_typical_min": 3.0,
