      "produces_component": "spiced masala",
      "station": "burner",
      "interruptible": false,
      "freshness": "none",
      "freshness_cue": null,
      "max_lead_min": null,
      "doneness_cue": "jab tak oil chamakne lage"
    },
    {
      "text": "Soaked chole ko add karein, meetha soda 1/4 tsp milaye aur ek aloo (chhilka ke saath) daal dein; phir khatai wala paani chaan kar daalein aur normal pani 1 1/2 se 2 cups tak add karein, achhi tarah mix karein.",
      "label": "Add chole and water",
      "attention": "hands_on",
