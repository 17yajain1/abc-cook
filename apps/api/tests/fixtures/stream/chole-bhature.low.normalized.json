      "max_lead_min": null,
      "doneness_cue": null
    },
    {
      "text": "Amla aur chaipatti wala pani (1 1/2 cups) aur sukha amla 8-10 pieces ko ubalne ke liye rakhen (khatai ke liye).",
      "label": "Make khatai water",
      "attention": "hands_on",
