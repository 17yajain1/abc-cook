        "Maida"
      ],
      "produces_component": "suji-maida mix",
      "station": "counter",
      "interruptible": true,
      "freshness": "none",
      "freshness_cue": null,
      "max_lead_min": null,
      "doneness_cue": null
    },
    {
      "text": "Bhature ka dough banaye: maida+suji mix mein namak 2 tsp, cheeni 2 tsp, baking soda/meetha soda 1/2 tsp daal kar dahi aur thoda pani mila ke tight dough banaye; 7 मिनट तक achhi tarah gundhe (\"7 मिनट\") aur phir 3–4 मिनट aur masaj karein, phir 1 tbsp oil mila kar 3–4 मिनट masaj karein.",
      "label": "Knead dough",
      "attention": "hands_on",
      "attention_cue": null,
      "duration_typical_min": 14.0,
      "duration_min": 14.0,
      "duration_max": 18.0,
      "duration_stated": false,
      "depends_on_previous": true,
      "depends_on_steps": [
        1,
        2
      ],
      "role": "required",
