      "doneness_cue": null
    },
    {
      "text": "Pressure cooker garam karein, 2 tbsp oil dal kar garam masala ke liye badi ilaichi aur dalchini, 1/2 tsp kali mirch, 1 green cardamom, 3-4 cloves daal kar phenk kar bhune; phir pyaaz-anardana paste daal kar 1 minute tak bhune aur 1/2 tsp ginger garlic paste milaye.",
      "label": "Sauté base",
      "attention": "hands_on",
      "attention_cue": null,
