      "freshness": "none",
      "freshness_cue": null,
      "max_lead_min": null,
      "doneness_cue": null
    },
    {
      "text": "Bhature ke liye suji ko 1 cup pani mein 5 मिनट tak bhigo kar phir extra pani nikal kar halkasa nichod kar suji ko maida (2 cups) ke saath milaye.",
      "label": "Mix suji",
      "attention": "hands_on",
      "attention_cue": null,
      "duration_typical_min": 7.0,
      "duration_min": 5.0,
      "duration_max": 10.0,
      "duration_stated": false,
      "depends_on_previous": false,
      "depends_on_steps": [],
