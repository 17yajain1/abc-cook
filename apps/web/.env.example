# Copy to .env.local (gitignored) to override. Vite only exposes VITE_-prefixed vars.

# Base URL of the FastAPI server. Leave unset in dev: the client defaults to
# http://<this-page's-hostname>:8000, which is what makes the app work when opened
# from a phone over the LAN (localhost would resolve to the phone itself).
# Set it only when the API is somewhere else, e.g. a deployed URL.
# VITE_API_BASE=http://192.168.1.10:8000

# Public-recipes feed on Home. Off unless set to 1. In a dev build, `?feed=1` also turns
# it on for that page load without touching this file.
VITE_FEATURE_FEED=0
